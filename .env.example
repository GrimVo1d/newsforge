# Copy to .env and adjust. docker compose reads it automatically; all values are optional
# for the dev stack. Variables marked "prod" are required with newsforge.settings.prod.

# Django
# DJANGO_SETTINGS_MODULE=newsforge.settings.dev
# SECRET_KEY=                                # prod: random, at least 50 characters
# ALLOWED_HOSTS=localhost,127.0.0.1          # prod: comma-separated host names
# DEBUG=false                                # true in newsforge.settings.dev
# LOG_LEVEL=INFO
# METRICS_TOKEN=                             # /metrics answers 404 unless this bearer token is sent

# API throttling
# THROTTLE_ANON=120/min
# THROTTLE_USER=600/min
# THROTTLE_AUTH=10/min                       # register / token / refresh
# THROTTLE_REGISTER=20/day                   # accounts created per client address
# THROTTLE_SEARCH=60/min
# NUM_PROXIES=0                              # trusted proxies in front of the API (X-Forwarded-For)

# Crawler
# USER_AGENT=newsforge/0.1
# HTTP_TIMEOUT=20                            # seconds per fetch, all redirects included
# MAX_ENTRIES_PER_FETCH=200
# ALLOW_PLAIN_HTTP=false                     # allow http:// feed and webhook URLs
# MAX_RESPONSE_BYTES=5242880
# PER_DOMAIN_MIN_INTERVAL=30

# Subscriptions
# MAX_SUBSCRIPTIONS_PER_USER=20
# MAX_ACCOUNTS_PER_TARGET=5                  # other accounts per email address / webhook URL

# Email delivery for subscriptions
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=false
# DEFAULT_FROM_EMAIL=no-reply@newsforge.local

# Processes
# GUNICORN_WORKERS=4
# CELERY_CONCURRENCY=4
# CELERY_QUEUES=default,low
# CELERY_LOG_LEVEL=INFO
# CELERY_TASK_SOFT_TIME_LIMIT=60
# CELERY_TASK_TIME_LIMIT=90
# CELERY_MAX_MEMORY_PER_CHILD=262144         # KiB; a pool process is replaced above this

# Production only (newsforge.settings.prod)
# SECURE_SSL_REDIRECT=true
# TRUST_X_FORWARDED_PROTO=false              # true only behind a proxy that always sets it
# SECURE_HSTS_PRELOAD=false
